{
  "module_path": "github.com/agezt/agezt",
  "rules": [
    {"pattern": "kernel/contract/...", "layer": 1, "note": "target home of pure contracts (W1.1)"},
    {"pattern": "kernel/platform/...", "layer": 2, "note": "target home of infrastructure (W1)"},
    {"pattern": "kernel/modules/*/...", "layer": 3, "module": "@1", "note": "target home of bounded contexts (W3)"},
    {"pattern": "kernel/app/...", "layer": 4, "note": "operation registry + pipelines (W2)"},
    {"pattern": "kernel/adapters/...", "layer": 5, "note": "inbound transports (W2)"},

    {"pattern": "internal/...", "layer": 0},

    {"pattern": "kernel/event", "layer": 1},
    {"pattern": "kernel/ulid", "layer": 1},
    {"pattern": "kernel/channel", "layer": 1, "note": "Channel interface + UnifiedMessage + manifest registry"},
    {"pattern": "kernel/tenantctx", "layer": 1},
    {"pattern": "kernel/meshctx", "layer": 1},
    {"pattern": "kernel/intervention", "layer": 1, "note": "live-change grammar types"},

    {"pattern": "kernel/journal", "layer": 2, "note": "-> platform/eventlog"},
