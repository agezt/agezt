    {"pattern": "kernel/envscrub", "layer": 2, "note": "-> platform/sandbox"},
    {"pattern": "kernel/executionprofile", "layer": 2, "note": "-> platform/sandbox"},
    {"pattern": "kernel/netguard", "layer": 2, "note": "-> platform/netout"},
    {"pattern": "kernel/redact", "layer": 2},
    {"pattern": "kernel/creds/...", "layer": 2, "note": "-> platform/secrets"},
    {"pattern": "kernel/settings", "layer": 2, "note": "-> platform/config"},
