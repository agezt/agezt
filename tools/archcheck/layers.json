    {"pattern": "kernel/tenant", "layer": 2, "note": "-> platform/tenancy"},
    {"pattern": "kernel/state", "layer": 2, "note": "-> platform/filestore"},
    {"pattern": "kernel/httpserver", "layer": 2, "note": "-> platform/httpx"},
