    {"pattern": "kernel/toolbox", "layer": 3, "module": "extensions"},
    {"pattern": "kernel/acpcatalog", "layer": 3, "module": "extensions"},

    {"pattern": "kernel/catalog", "layer": 3, "module": "providers"},
    {"pattern": "kernel/chatgptauth", "layer": 3, "module": "providers"},

    {"pattern": "kernel/update", "layer": 3, "module": "system"},

    {"pattern": "kernel/voicetool", "layer": 3, "module": "media"},
    {"pattern": "kernel/imagetool", "layer": 3, "module": "media"},
    {"pattern": "kernel/reranktool", "layer": 3, "module": "media"},

    {"pattern": "kernel/controlplane", "layer": 5},
    {"pattern": "kernel/webui", "layer": 5},
    {"pattern": "kernel/restapi", "layer": 5},
    {"pattern": "kernel/openaiapi", "layer": 5},
    {"pattern": "kernel/agentgw", "layer": 5},
    {"pattern": "kernel/acp", "layer": 5},
    {"pattern": "kernel/webhook", "layer": 5, "note": "outbound dispatcher; event subscriber transport"},
    {"pattern": "kernel/tunnel", "layer": 5},

    {"pattern": "kernel/internal/testfixtures", "layer": 7, "note": "imported by tests only"},

    {"pattern": "plugins/...", "layer": 6},

    {"pattern": "cmd/...", "layer": 7},
    {"pattern": "sdk/...", "layer": 7},
    {"pattern": "tools/...", "layer": 7},
    {"pattern": "examples/...", "layer": 7},
    {"pattern": "contract/...", "layer": 7, "note": "legacy plugin-contract codegen; W0.5 trims dead halves"}
  ],
  "calls": [
    {"rule": "exec", "allow": ["kernel/warden", "kernel/platform/sandbox/..."]},
    {"rule": "http-client", "allow": ["kernel/netguard", "kernel/platform/netout/..."]},
    {"rule": "raw-write", "allow": ["kernel/platform/filestore/..."]}
  ]
